{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Start QEMU Debug",

            "type": "shell",

            "command": "make debug",

            "isBackground": true,

            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Listening"
                }
            }
        }
    ]
}